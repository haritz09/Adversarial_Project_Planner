# Groq API Key for Debaters and Judge
GROQ_API_KEY=your_groq_api_key_here

# Google API Key for Gemini (Generators)
GOOGLE_API_KEY=your_google_api_key_here

# Notion Connection Token
NOTION_TOKEN=ntn_your_notion_token_here

# The ID of the parent page where the project planner will create its pages
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# Langfuse Project Keys for Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
