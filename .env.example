# Models: provider:model. Every seat can be overridden.
PLANNER_MODEL_DEBATER=groq:llama-3.1-8b-instant
PLANNER_MODEL_JUDGE=groq:llama-3.3-70b-versatile
PLANNER_MODEL_GENERATOR=google_genai:gemini-2.5-flash

# Optional per-seat overrides
# PLANNER_MODEL_INTAKE=groq:llama-3.1-8b-instant
# PLANNER_MODEL_DEBATER_A=groq:llama-3.1-8b-instant
# PLANNER_MODEL_DEBATER_B=groq:llama-3.1-8b-instant

# Groq API key for debaters and judge
GROQ_API_KEY=your_groq_api_key_here

# Google API key for Gemini (generators)
GOOGLE_API_KEY=your_google_api_key_here

# Notion export (optional; without these the export is Markdown)
NOTION_TOKEN=ntn_your_notion_token_here
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENABLED=0
